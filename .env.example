# Required for worker startup validation
DATABASE_URL=postgres://slusko:slusko@postgres:5432/slusko
HF_TOKEN=
# Alternative to HF_TOKEN; either HF_TOKEN or HUGGINGFACE_TOKEN must be set
HUGGINGFACE_TOKEN=
WHISPER_MODEL=large-v3
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Runtime cache paths (Compose defaults shown)
MODEL_CACHE_DIR=/data/models
HF_HOME=/data/models

# Optional OpenRouter overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=120
